# The coverage configuration the run sub-action's pytest-cov reads when
# tests.yml runs the suite. `parallel` keeps the several python3 processes the
# suite starts from overwriting one another's data files. `omit` scopes the
# report to the repository's own surface -- every tracked Python file outside
# the suite and outside .github/ -- so a new module joins the measurement
# without an edit here; the suite's own files are measured too and simply do
# not appear in the report.

[run]
parallel = True

[report]
omit =
    */tests/*
    */.github/*
